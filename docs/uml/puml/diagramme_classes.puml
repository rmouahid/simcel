skinparam noteBorderColor #C8A800

title Diagramme de classes — Simulation de propagation de feu\nIssue #35 · version finale · v3.0

' ───────────────────────────────────────────────
' LÉGENDE
' ───────────────────────────────────────────────
legend top right
|= Notation |= Signification |
| <back:#FFF8DC>Enum</back> | Énumération |
| <back:#C8E6C9>Classe</back> | Classe modèle |
| <back:#FFE0B2>Ctrl</back> | Contrôleur |
| <back:#E1BEE7>Vue</back> | Vue |
| ─►  | dépendance |
| ◆──  | composition |
| ──▷  | implémentation / héritage |
endlegend

' ───────────────────────────────────────────────
' ÉNUMÉRATIONS
' ───────────────────────────────────────────────
enum CellState #FFF8DC {
  VIDE
  SAIN
  EN_FEU
  BRULE
  EAU
  ROCHER
  ..
  + getColor() : String
  + isFlammable() : boolean
  + isSpreading() : boolean
}

enum CellType #FFF8DC {
  FORET
  PRAIRIE
  BROUSSAILLES
  ZONE_HUMIDE
  ZONE_URBAINE
  ..
  + getInflammability() : double
  + getBurnDuration() : int
  + getHealthyColor() : String
}

enum WindDirection #FFF8DC {
  N · NE · E · SE
  S · SO · O · NO
  ..
  + getDx() : int
  + getDy() : int
}

enum SimulationState #FFF8DC {
  IDLE
  RUNNING
  PAUSED
}

' ───────────────────────────────────────────────
' INTERFACE
' ───────────────────────────────────────────────
interface SimulationListener <<FunctionalInterface>> #E8F5E9 {
  + onTick(tick : int, grid : Grid) : void
}

interface Serializable <<java.io>> #EEEEEE

' ───────────────────────────────────────────────
' POINT D'ENTRÉE
' ───────────────────────────────────────────────
class Main #EEEEEE {
  ..
  + start(stage : Stage) : void
  + {static} main(args : String[]) : void
  - {static} runCLI(args : String[]) : void
  - {static} hasActiveFire(grid : Grid) : boolean
}

' ───────────────────────────────────────────────
' MODEL
' ───────────────────────────────────────────────
class Cell #C8E6C9 {
  - state : CellState
  - type : CellType
  - remainingBurnTime : int
  ..
  + Cell(type : CellType)
  + getState() : CellState
  + getType() : CellType
  + getRemainingBurnTime() : int
  + setState(state : CellState) : void
  + ignite() : void
  + burnOut() : void
  + decrementBurnTime() : void
  + copy() : Cell
}

class Environment #C8E6C9 {
  + {static} MIN_WIND : int = 0
  + {static} MAX_WIND : int = 5
  + {static} MIN_HUMIDITY : int = 0
  + {static} MAX_HUMIDITY : int = 100
  - direction : WindDirection
  - windStrength : int
  - humidity : int
  ..
  + Environment()
  + Environment(d : WindDirection, w : int, h : int)
  + getDirection() : WindDirection
  + getWindStrength() : int
  + getHumidity() : int
  + setDirection(d : WindDirection) : void
  + setWindStrength(w : int) : void
  + setHumidity(h : int) : void
}

class Grid #C8E6C9 {
  - width : int
  - height : int
  - cells : Cell[][]
  - initialCells : Cell[][]
  ..
  + Grid(width : int, height : int)
  + isInBounds(x, y) : boolean
  + getCell(x, y) : Cell
  + setCell(x, y, c : Cell) : void
  + getNeighbors(x, y) : List<Cell>
  + initRandom(foret, prairie, broussailles, humide, urbaine : double) : void
  + saveInitialState() : void
  + reset() : void
  + setFire(x, y) : void
  + getWidth() : int
  + getHeight() : int
  + copyCells() : Cell[][]
  + copyInitialCells() : Cell[][]
  + restoreState(cells, init) : void
}

class FireSimulator #C8E6C9 {
  - grid : Grid
  - environment : Environment
  - listeners : List<SimulationListener>
  - random : Random
  - history : Deque<Cell[][]>
  - currentTick : int
  ..
  + FireSimulator(g : Grid, e : Environment)
  + tick() : void
  + getGrid() : Grid
  + getEnvironment() : Environment
  + addListener(l : SimulationListener) : void
  + stepBack() : boolean
  + clearHistory() : void
  + createSnapshot() : SimulationSnapshot
  + applySnapshot(s : SimulationSnapshot) : void
}

class SimulationSnapshot #C8E6C9 {
  - width : int
  - height : int
  - cells : Cell[][]
  - initialCells : Cell[][]
  - windDirection : WindDirection
  - windStrength : int
  - humidity : int
  - tick : int
  ..
  + SimulationSnapshot(w, h : int, cells, init : Cell[][], env : Environment, tick : int)
  + getWidth() : int
  + getHeight() : int
  + getCells() : Cell[][]
  + getInitialCells() : Cell[][]
  + getWindDirection() : WindDirection
  + getWindStrength() : int
  + getHumidity() : int
  + getTick() : int
}

class SimulationIO <<final>> #C8E6C9 {
  - SimulationIO()
  ..
  + {static} save(f : File, s : SimulationSnapshot) : void
  + {static} load(f : File) : SimulationSnapshot
}

' ───────────────────────────────────────────────
' CONTROLLER
' ───────────────────────────────────────────────
class SimulationController #FFE0B2 {
  - simulator : FireSimulator
  - state : SimulationState
  - tickDelay : int
  - simulationThread : Thread
  ..
  + SimulationController(s : FireSimulator, delay : int)
  + start() : void
  + pause() : void
  + step() : void
  + stop() : void
  + reset() : void
  + stepBack() : boolean
  + setTickDelay(ms : int) : void
  + getTickDelay() : int
  + getState() : SimulationState
  + saveToFile(f : File) : void
  + loadFromFile(f : File) : void
}

' ───────────────────────────────────────────────
' VIEW
' ───────────────────────────────────────────────
class MainWindow #E1BEE7 {
  - simulator : FireSimulator
