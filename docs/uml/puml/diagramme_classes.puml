  + setGridSize(w : int, h : int) : void
  + resetTick() : void
  + onTick(tick : int, grid : Grid) : void
}

class GridView <<Canvas>> <<final>> #E1BEE7 {
  - cellSize : double
  ..
  + GridView(grid : Grid, cellSize : double)
